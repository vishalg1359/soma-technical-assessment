generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Todo {
  id             Int       @id @default(autoincrement())
  title          String
  dueDate        DateTime?
  imageUrl       String?
  imageAlt       String?
  imageCredit    String?
  imageStatus    String    @default("pending")
  imageCheckedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([imageStatus])
}
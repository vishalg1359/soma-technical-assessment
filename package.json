{
  "name": "soma-todo-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "test:timezones": "for tz in UTC Europe/London Asia/Kolkata America/Los_Angeles Pacific/Kiritimati; do echo \"== $tz\" && TZ=$tz vitest run || exit 1; done",
    "test:concurrency": "node scripts/concurrency-check.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^14.2.35",
    "react": "^18",
    "react-dom": "^18"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "brace-expansion": "^2.1.4",
    "glob": "^10.5.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.23",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
